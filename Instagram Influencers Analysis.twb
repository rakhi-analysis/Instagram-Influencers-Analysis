        <calculation class='tableau' formula='IF RIGHT([followers],1) = &apos;k&apos; THEN&#13;&#10;    FLOAT(LEFT([followers], LEN([followers])-1)) * 1000&#13;&#10;ELSEIF RIGHT([followers],1) = &apos;m&apos; THEN&#13;&#10;    FLOAT(LEFT([followers], LEN([followers])-1)) * 1000000&#13;&#10;ELSEIF RIGHT([followers],1) = &apos;b&apos; THEN&#13;&#10;    FLOAT(LEFT([followers], LEN([followers])-1)) * 1000000000&#13;&#10;ELSE&#13;&#10;    FLOAT([followers])&#13;&#10;END' />
