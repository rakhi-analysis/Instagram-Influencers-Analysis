        <calculation class='tableau' formula='IF RIGHT([avg_likes],1) = &apos;k&apos; THEN&#13;&#10;    FLOAT(LEFT([avg_likes], LEN([avg_likes])-1)) * 1000&#13;&#10;ELSEIF RIGHT([avg_likes],1) = &apos;m&apos; THEN&#13;&#10;    FLOAT(LEFT([avg_likes], LEN([avg_likes])-1)) * 1000000&#13;&#10;ELSEIF RIGHT([avg_likes],1) = &apos;b&apos; THEN&#13;&#10;    FLOAT(LEFT([avg_likes], LEN([avg_likes])-1)) * 1000000000&#13;&#10;ELSE&#13;&#10;    FLOAT([avg_likes])&#13;&#10;END' />
      </column>
      <column caption='New Post Average Likes (Fixed)' datatype='real' name='[Calculation_530017383054147591]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF RIGHT([new_post_avg_like],1) = &apos;k&apos; THEN&#13;&#10;    FLOAT(LEFT([new_post_avg_like], LEN([new_post_avg_like])-1)) * 1000&#13;&#10;ELSEIF RIGHT([new_post_avg_like],1) = &apos;m&apos; THEN&#13;&#10;    FLOAT(LEFT([new_post_avg_like], LEN([new_post_avg_like])-1)) * 1000000&#13;&#10;ELSEIF RIGHT([new_post_avg_like],1) = &apos;b&apos; THEN&#13;&#10;    FLOAT(LEFT([new_post_avg_like], LEN([new_post_avg_like])-1)) * 1000000000&#13;&#10;ELSE&#13;&#10;    FLOAT([new_post_avg_like])&#13;&#10;END' />
